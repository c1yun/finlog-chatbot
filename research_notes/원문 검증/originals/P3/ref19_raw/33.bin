						<!-- 2021 주요뉴스 -->
												<div class="maj_list_wrap">
							<p class="tit_m_st">주요 뉴스<span class="tit_ico img_element"></span></p>
							<div class="maj_list_container">
								<ul>
																		<li class="maj_list">
                                        								        <div class="maj_list_thum">
    								        <a href="https://www.etoday.co.kr/news/view/2635484?trc=view_hot_news">
    								        	<img src="https://img.etoday.co.kr/crop/140/88/2401055.jpg" alt="IMF, 韓 부채비율 54.4→46.1% 하향…&amp;quot;GDP 성장·세입 개선&amp;quot;">
    								        </a>
								        </div>
								        								        <dl>
								            <dt class="t_reduce maj_tit">
    								            <a href="https://www.etoday.co.kr/news/view/2635484?trc=view_hot_news">
    									                	    										IMF, 韓 부채비율 54.4→46.1% 하향…&quot;GDP 성장·세입 개선&quot;	    										</a>
								            </dt>
