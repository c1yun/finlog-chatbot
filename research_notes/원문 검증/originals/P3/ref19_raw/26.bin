                //     </div>\
                // </div>');
                (function () {
                    let $anchor = $('br.paragraph[data-index=0]').first();
                    let adId = 'mobwith_10883557';

                    if (
                        !$anchor.length ||
                        typeof window.MobWithAd !== 'function' ||
                        document.getElementById(adId)
                    ) {
                        return;
                    }

                    let $previousBreak = $anchor.prev('br');
                    let $adArea = $('<div class="ad-area is-mobile"></div>')
                        .insertBefore($anchor);

                    let originalWrite = document.write;
                    let rendered = false;

                    try {
                        document.write = function () {
                            let html = Array.prototype.join.call(arguments, '');
                            $adArea[0].insertAdjacentHTML('beforeend', html);
                        };

                        new window.MobWithAd({
                            id: adId,
                            zone: '10883557',
                            adType: 'banner',
                            bannerType: 'bottom',
                            width: '300',
                            height: '250',
                            pb: '',
                            position: ''
                        });

                        rendered = !!document.getElementById('wrap_' + adId);
                    } catch (error) {
                        if (window.console && window.console.warn) {
                            window.console.warn('[MobWith] 광고 초기화 실패', error);
                        }
                    } finally {
                        document.write = originalWrite;
                    }

                    if (rendered) {
                        $adArea.find('iframe').attr('title', '광고');
                        $previousBreak.add($anchor).hide();
                    } else {
                        $adArea.remove();
                    }
                })();
                /**/

                /**/
                // 2024.08.16 티즈 3문단 by jun
                $('br.paragraph[data-index=2]').hide().prev('br').hide();
