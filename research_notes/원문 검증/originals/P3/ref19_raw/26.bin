                            <!-- [D] 기사본문 -->
                            <div class="article-body" id="magazineView" itemprop="articleBody">
                                <!-- 인라이플 오디오 영역 2021.02.23 -->
                                <div class="util-audio-area">
                                    <div itemprop="audioBody" id="audioBody">
                                        <script> document.write('<scr'+'ipt type="text/javascript" defer src="https://movideo.ai/sc/aiAudioScript?from='+escape(document.location.href)+'&type=script&a=93"></scr'+'ipt>');</script>
