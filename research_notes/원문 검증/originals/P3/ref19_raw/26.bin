        <!-- 2025.02.20 유료기사월 추가 -->

        <script>

        // 2023.05.15 라이브리댓글 광고영역 제거 by jun
        // 2023.06.07 복구
        //window.onload = function(){
        //    $('#livereAdWrapper').remove();
        //}

        // Sticky header
        var headerTop = $('.header-media').offset().top;
        var headerH = $('.header-media').outerHeight();
        // 초기 .header-media 높이 세팅(fixed 후 스크롤 움직임 방지)
        $('.header-media').css('height',headerH);
        // 스크롤이 헤더 영역을 지나면 html태그에 .isSticky 토글
        $(window).scroll(function() {
            var winScr = $(this).scrollTop();
            if (winScr > headerTop + headerH) {
                $('html').addClass('isSticky');
            } else {
                $('html').removeClass('isSticky');
            }
        });

        $(function(){

            // 좌측날개 fixed
            if($('.fltAd .left').length > 0){
                var asideTop = $('.fltAd .left').offset().top;

                $(window).on("scroll", function () {
                    var asideHeight = $(".fltAd .left").outerHeight();

                    if($(".article-body").outerHeight() >= asideHeight){
                        if(window.pageYOffset >= asideTop) {
                            $('.fltAd').css({"position":"fixed"});
                            $('.fltAd .left').css({"top":"100px"});
                        } else {
                            $('.fltAd').css({"position":"absolute"});
                            $('.fltAd .left').css({"top":asideTop+"px"});
                        }
                    }
                });
            }
            /** teads 광고스크립트와의 충돌 이슈로 data-index >> data-index로 변경 2024.01.30 by jun */
            var constents = $('#magazineView').contents();
            var constentsLength = constents.length;

            for(i = 0; i < constentsLength; i++){
                if((constents[i].localName == 'br' && constents[i].previousSibling.localName == 'br' && constents[i].nextSibling.localName != 'br') || (constents[i].nodeName == 'BR' && constents[i].previousSibling.nodeName == 'BR' && constents[i].nextSibling.nodeName != 'BR')){
                    $(constents[i]).addClass('paragraph').attr('data-index',paragraph);
                    paragraph++;
                }
            }

            if(paragraph < 3){
                if($('#magazineView > p').length == 1 && $('#magazineView > p > br').length > 4){
                    $('#magazineView .paragraph').removeAttr('data-index').removeClass('paragraph');

                    constents = $('#magazineView > p').contents();
                    constentsLength = constents.length;
                    paragraph = 0;
                    for(i = 0; i < constentsLength; i++){
                        if((constents[i].localName == 'br' && constents[i].previousSibling.localName == 'br' && constents[i].nextSibling.localName != 'br') || (constents[i].nodeName == 'BR' && constents[i].previousSibling.nodeName == 'BR' && constents[i].nextSibling.nodeName != 'BR')){
                            $(constents[i]).addClass('paragraph').attr('data-index',paragraph);
                            paragraph++;
                        }
                    }
                }else if($('#magazineView > div').length == 1 && $('#magazineView > div > br').length > 4){
                    $('#magazineView .paragraph').removeAttr('data-index').removeClass('paragraph');

                    constents = $('#magazineView > div').contents();
                    constentsLength = constents.length;
                    paragraph = 0;
                    for(i = 0; i < constentsLength; i++){
                        if((constents[i].localName == 'br' && constents[i].nextSibling.localName != 'br') || (constents[i].nodeName == 'BR' && constents[i].previousSibling.nodeName == 'BR' && constents[i].nextSibling.nodeName != 'BR')){
                            $(constents[i]).addClass('paragraph').attr('data-index',paragraph);
                            paragraph++;
                        }
                    }
                }
            }

            if(isMobile) {
                // 2026.07.30 플로팅 광고 추가 by jun
                if(media == 'business') {
                    new HawkEyes({"type":"floating","responsive":"Y","platform":"M","scriptCode":"1066386","frameCode":"46","width":"100","height":"100","settings":{"cntad":"1","cntsr":"1", "fType":"chatbot", "bottom":"0", "scroll":"false", "useAdDelete":"false"}});
                } else if(media == 'money') {
                    new HawkEyes({"type":"floating","responsive":"Y","platform":"M","scriptCode":"1066388","frameCode":"46","width":"100","height":"100","settings":{"cntad":"1","cntsr":"1", "fType":"chatbot", "bottom":"0", "scroll":"false", "useAdDelete":"false"}});
                } else if(media == 'job-joy') {
                    new HawkEyes({"type":"floating","responsive":"Y","platform":"M","scriptCode":"1066389","frameCode":"46","width":"100","height":"100","settings":{"cntad":"1","cntsr":"1", "fType":"chatbot", "bottom":"0", "scroll":"false", "useAdDelete":"false"}});
                }

                /* n문단 아래에 넣으려면 data-index=[n-1]에 넣으면 됨*/

                // 2025.06.13 신규 추가(1문단 뒤) by jun
                /**/
