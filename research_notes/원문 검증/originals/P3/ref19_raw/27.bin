<script type="module">
const apiDomain = (location.host.startsWith("stg-") == true ? "https://apidev-connect.hankyung.com": "https://api-connect.hankyung.com");

const get_user_pseudo_id = () => {
    let user_pseudo_id = "111111111.1111111111";

    if($.cookie("_ga")){
        const ga = $.cookie("_ga").split(".");

        user_pseudo_id = `${ga[2]}.${ga[3]}`;
    }

    return user_pseudo_id;
}

const get_recommend_news = async () => {
    const url = `${apiDomain}/recommend/news`;

    const param = {
        event_type: "view-home-page",
        user_pseudo_id: get_user_pseudo_id(),
        page_size: 3,
        user_id: $.cookie("UserNo"),
    };

    try{
        const response = await fetch(url, {
            headers: {
                "Content-type": "application/json",
            },
            credentials: "include",
            method: "POST",
            body: JSON.stringify(param),
        });

        const data = await response.json();

        if(data.code == 200){
            set_recommend_news(data.data);
        }else{
            throw Error(data.message);
        }
    }catch(error){
        console.log(error);
    }
}

const set_recommend_news = (data) => {
    $(".layer-floating-recommended ul.recommended-news-list").html('');

    $.each(data.list, (idx, val) => {
        $(".layer-floating-recommended ul.recommended-news-list").append(`
            <li>
                <div class="news-item">
                    <div class="txt-cont">
                        <a href="/article/${val.aid}" class="news-tit">${val.title}</a>
                    </div>
                    ${val.images && val.images.length > 0 ?
                    `<div class="thumb">
                        <a href="/article/${val.aid}">
                            <img src="${val.images[0]}" alt="${htmlspecialchars(val.title)}">
                        </a>
                    </div>`
                    : ''
                    }
                </div>
            </li>
        `);
    });

    $(".layer-floating-recommended .loading").hide();
    $(".layer-floating-recommended .recommended-news-list").show();
}

$(() => {
    if (document.cookie.indexOf('_ga=') < 0 && document.cookie.indexOf('UserNo=') < 0) {
        $('#floating-recommended').remove();
        return false;
    }

    // AI 추천 뉴스 오픈
    $('.btn-open-recommended').on("click", function() {
        $(this).removeClass('floating-slide-in').addClass('floating-slide-out');

        $(".layer-floating-recommended .loading").show();
        $(".layer-floating-recommended .recommended-news-list").hide();

        $('.layer-floating-recommended').removeClass('floating-slide-out').addClass('floating-slide-in');

        get_recommend_news();
    });

    // AI 추천 뉴스 닫기
    $('.floating-btn-close').on("click", function() {
        $(this).parents('.layer-floating-recommended').removeClass('floating-slide-in').addClass('floating-slide-out');
        $('.btn-open-recommended').removeClass('floating-slide-out').addClass('floating-slide-in');
    });
});
</script>                        </div>
