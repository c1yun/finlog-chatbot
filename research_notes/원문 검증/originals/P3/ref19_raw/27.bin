<script>
const padata = {"aid":"2025121316857","title":" \uc0bc\uc131\uc804\uc790\u00b7SK\ud558\uc774\ub2c9\uc2a4 \ub2e4 \uc81c\ucce4\ub2e4\u2026\ucde8\uc5c5 \uc120\ud638\ub3c4 '1\uc704' \uae30\uc5c5\uc740  ","category":"\uc0ac\ud68c","reporters":["406"]};
function sendViewed(){
    let url = "https://api-personal.hankyung.com/recently-viewed/v1/views";

    if(location.host.includes("stg-") == true){
        url = "https://apidev-personal.hankyung.com/recently-viewed/v1/views";
    }
    fetch(url, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'Authorization': $.cookie('accessToken')
        },
        body: JSON.stringify(padata)
    });
}
if($.cookie('accessToken')){
    sendViewed();
}
</script>
