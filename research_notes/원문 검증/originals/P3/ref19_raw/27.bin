<script>
// (() => {
    
// })();

function loginCheck(){
    // 운영/개발서버 회원 도메인(member) 분기
    let is_stg = false;

    if(location.host != location.host.replace("stg-", "") || location.host == "markets-dev.hankyung.com"){
        is_stg = true;
    }

    const url = escape(document.location.href);

    // 프리미엄 구독
    $(".header-account-info a.premium9_subscribe").attr("href", `https://${is_stg == true ? "stg-www.hankyung.com" : "www.hankyung.com"}/premium9/intro`);

    // 로그인 버튼
    $(".header-account-info a.btn-login").attr("href", `https://${is_stg == true ? "stg-member.hankyung.com" : "member.hankyung.com"}/apps.frame/login?url=${url}`);

    // 마이한경
    $(".header-account-info a.my-hankyung").attr("href", `https://${is_stg == true ? "stg-www.hankyung.com" : "www.hankyung.com"}/myhankyung`);

    const user_id = $.cookie('UserId');
    const tokenCookie = $.cookie('ssoToken');

    if(!tokenCookie){
        $(".header-account-info .before-login").show();
        $(".header-account-info .after-login").remove();
        return false;
    }

    let checkFlag = true;

    if( $.cookie('ssoTokenCheckTime') && user_id){
		const checkTime = $.cookie('ssoTokenCheckTime');
		const today = new Date().toISOString().substring(0,10);

		if( checkTime == today ) checkFlag = false;
	}

    if(!checkFlag){
        setSingInfo({result_code:'0000'});
        return false;
    }

    // 2024.09.26 운영/stg 토큰 구분 추가
    let tokenUrl = `https://${is_stg == true ? "stg-member.hankyung.com" : "member.hankyung.com"}/apps.frame/sso.check.token`;

    $.ajax({
        type : "POST",
        url : tokenUrl,
        crossDomain: true,
        dataType: 'jsonp',
        jsonp: 'jsonp_callback',
        data : {'token' : tokenCookie,
                'key' : "a8bdf898783883b64503b8915deeb57767f935a24daf44150723299c01c8898a",
                'fn' : "setSingInfo"
        }
    });
}

loginCheck();

function checkPremiumUser(){
    const token = $.cookie("accessToken");

    if(!token){
        return false;
    }

    try {
        const base64Url = token.split('.')[1];
        const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
        const jsonPayload = decodeURIComponent(atob(base64).split('').map(function(c) {
            return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
        }).join(''));

        const payload = JSON.parse(jsonPayload);
        if($.inArray("811001", payload.sf_result) >= 0){
            return true;
        }else{
            return false;
        }
    } catch (e) {
        return false;
    }
}

function setSingInfo(result){
    // 로그아웃상태/로그인 실패시
    if(result.result_code != "0000"){
        $(".header-account-info .before-login").show();
        $(".header-account-info .after-login").remove();
        return false;
    }

    // 로그인 영역 오픈
    const is_premium = checkPremiumUser();

    if(is_premium == true){
        $(".icon-user-general").remove();
        $(".icon-user-premium9").show();
    }else{
        $(".icon-user-general").show();
        $(".icon-user-premium9").remove();
    }

    $(".header-account-info .before-login").remove();
    $(".header-account-info .after-login").show();
}
</script>
