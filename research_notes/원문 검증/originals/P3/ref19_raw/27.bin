<script>
$(document).ready(function(){
	// 검색 레이어 열고/닫기
	$('.hk-top__search .btn-total-search').on("click", function() {
		$('.hk-top__search .btn-inp-reset').trigger('click');
		$('.hk-top__search').toggleClass('active');
		$('.hk-top__search__layer input[type=search]').focus();
	});

	$('.hk-top__search .btn-close').on("click", function() {
		$('.hk-top__search').removeClass('active');
	});

	$(document).on('mouseup',function(e){
		if (!$(e.target).hasClass('hk-top__search__layer') && !$(e.target).parents().hasClass('hk-top__search__layer')) {
			$('.hk-top__search').removeClass('active');
		};
	});

	// 검색어 입력시 종목정보 호출
	$('.hk-top__search input[type=search]').on('keyup', function(){
		if($(this).val().trim().length < 2){
			$('.hk-top__search .btn-inp-reset').hide();
			$('.hk-top__search .btn-search').hide();
			$('.hk-top__search .hk-top__search__layer').removeClass('auto');
			return false;
		}

		$('.hk-top__search__layer .btn-inp-reset').show();
		$('.hk-top__search__layer .btn-search').show();

		const keyword = $(this).val().trim()
		const url = "https://api-www.hankyung.com/search/finance/list?keyword="+encodeURI(keyword);

		$.get(url, function(data, status) {
			// 데이터 호출 실패
			if(data.code != 200){
				$('.hk-top__search .hk-top__search__layer').removeClass('auto');
				return;
			}

			// 데이터 개수가 없을 경우
			if(data.data.list.length == 0){
				$('.hk-top__search .hk-top__search__layer').removeClass('auto');
				return;
			}

			$(".hk-top__search .autocomplete-result").html('');

			$.each(data.data.list, function(idx, val){
				val.code = val.code.replace(keyword, `<mark>${keyword}</mark>`);
				val.name = val.name.replace(keyword, `<mark>${keyword}</mark>`);

				$(".hk-top__search .autocomplete-result").append(`
					<li class="type-stock">
						<a href="${val.url}" title="${val.code}">
							<span class="code">${val.code}</span>
							<span class="name">${val.name}</span>
							<span class="category">${val.market}</span>
						</a>
					</li>
				`);
			});

			$('.hk-top__search .hk-top__search__layer').addClass('auto');
		});
	});

	// 검색어 삭제
	$('.hk-top__search .btn-inp-reset').on('click', function(){
		$('.hk-top__search input[type=search]').val('');
		$('.hk-top__search .btn-inp-reset').hide();
		$('.hk-top__search .btn-search').hide();
		$('.hk-top__search .hk-top__search__layer').removeClass('auto');
	});
});
</script>
