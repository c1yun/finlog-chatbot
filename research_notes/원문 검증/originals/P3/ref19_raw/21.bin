<script>
	function goLink(linkUrl) {
		window.open(linkUrl, '_blank');
	}

	$(document).on('click', '.footer-sns .footer-sns-link', function () {
		var $link = $(this);
		var data = $.param({
			linkNm: $link.attr('data-link-nm') || '',
			targetKey: 'FOOTER_SNS',
			snsSe: $link.attr('data-sns-se') || ''
		});
		var url = '/kr/log/extern';

		if (window.navigator && navigator.sendBeacon && window.Blob) {
			if (navigator.sendBeacon(url, new Blob([data], { type: 'application/x-www-form-urlencoded;charset=UTF-8' }))) {
				return;
			}
		}

		$.ajax({
			type: 'POST',
			url: url,
			data: data
		});
	});
</script>

