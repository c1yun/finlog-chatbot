	<script>
		// header 영역 로그인 시 로그인 전 페이지로 이동을 위한 함수 - 20181030
		
		function loginDefault(){
			location.href="/login?autoUrl=" + location.pathname;
		}
		
		$(document).ready(function(){
			$(function() {
				var cType = $('body').data('client-type');
				if (cType === 'app') {
					if ($.cookie("newBadge")) {
						$("#newPushMsgMark").show();
					} else {
						$("#newPushMsgMark").hide();
					}
				}
			});
		
		
			//
		
			var agentType = $('body').data('client-type');
			
		// 	alert(agentType);
			console.log("agentType : " + agentType);
			if (agentType == 'app') {
				$("#id-app-menu").show();
				console.log("$('#id-app-menu').show()");
			} else {
				$("#id-app-menu").hide();
				console.log("$('#id-app-menu').hide()");
			}
			// series , model 상세 page gnb 활성화
			if(location.pathname.indexOf("/series/") > -1 || location.pathname.indexOf("/model/") > -1) {
				$("a[href='/menu/forward/7']").closest("li").addClass("active");
				$("[data-categoryon]").each(function(){	// crumbs
					var onSn = $(this).data("categoryon");
					$("[data-menuctgry]").each(function(){
						if($(this).data("menuctgry") == onSn) {
							$(this).addClass("active");
						}
					});
				});
			}
		
			// mo
			$(".mobile_mn_op").on("click", function(){
				if($(this).hasClass('act')){
					if($("#gnbmenu").find(".active").length > 0){
						var gwrap = $("#gnbmenu").find(".active").closest("ul");
						gwrap.show();
						if(gwrap.hasClass("depth3")) {
							gwrap.closest("ul.depth2").show();
							gwrap.closest("ul.depth2").closest("li.sub-visible").addClass("on");
						} else if(gwrap.hasClass("depth2")) {
							gwrap.closest("li.sub-visible").addClass("on");
						}
					}
		
					// mypage
					if(location.pathname.indexOf("/mypage/") == 0) {
						$(".mypage").click();
						$(".mypage-menu").find("a").each(function(){
							if(location.pathname.indexOf($(this).attr("href")) == 0) {
								$(this).closest("li").addClass("active");
								if($(this).closest("ul").hasClass("depth2")) {
									$(this).closest("ul").show();
									$(this).closest("ul").parent().addClass("active");
								}
							}
						});
					}
				}
			});
			
		
			// search
			$(document).on("click", "a[data-searchkwd]", function(){
				location.href = "/search?category=TAG&kwd=" + encodeURI ($(this).data("searchkwd"));
			});
		
		});
	</script>
	<!-- 기존 inc/header 소스 이동 : end -->

	
