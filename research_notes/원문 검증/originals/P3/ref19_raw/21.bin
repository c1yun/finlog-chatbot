<script type="text/javascript" src="/js/plugins/clipboard.min.js"></script>
<script type="text/javascript">

function login(){	
	if(confirm('로그인이 필요합니다. 로그인 하시겠습니까?')) {
		location.href="/login?autoUrl=" + location.pathname;
	}
}

$(document).ready(function(){
	console.log("foot init");
	
	
	// url copy
	var clip = new Clipboard('.foot-urlcopy', {
	    text: function(trigger) {
	        return location.href;
	    }
	});
	clip.on("success", function(e) {
		// URL이 복사되었습니다.
		alert("URL이 복사되었습니다.");
	});
	$(".foot-urlcopy").on("click", function(){
		$.log({ mode:"urlcopy"	,uri:location.pathname });
	});

	// print
	$(".foot-print").on("click", function(){
		$.log({ mode:"print"	,uri:location.pathname });
	});

	// download : 공통 다운로드 // group 은 스마트바에서 사용.
	$(document).on("click", "a[href^='/common/download/']", function(){
		var group = $(this).data("group");
		if(group == undefined || group == '') group = location.pathname;
		$.log({ mode:"download"	,uri:group , atchSn: $(this).data("atchsn")});
	});
	
	
});

function log_download(atchsn, group) {
	if(group == undefined || group == '') group = location.pathname;
	$.log({ mode:"download"	,uri:group , atchSn: atchsn});
}

</script>
