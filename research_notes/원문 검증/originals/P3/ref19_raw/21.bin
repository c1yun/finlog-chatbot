<script type="text/javascript">
//$( document ).ready(function() {	
$(window).on("load", function(){	
	var locale = 'ko_KR';		
	
	if (locale != 'ru_RU') {
	    $.ajax({
	        type: 'post',
	        url: '/kr/ksf/api/rankings',
	        data: {'domain_no':getDomainNo(locale)},
	        dataType: 'json',
	        success: function(data) {
	        	/* console.log(data+","+data.length + getDomainNo(locale)); */ 
	        	/* data = null; */ //인기검색어 안정화 될때까지 화면에 표시안되게 설정한다..
	        	if(data==null ){
	        		var MsgHtml  =  "<p class=\"none-search-word\">내가 찾은 검색어 목록이 없습니다.</p>";
	        		$('#ppk').append(MsgHtml); 
        		}
	        	else{
		            /* console.log(data+","+data.length + getDomainNo(locale)); */
		            $.each(data, function(i,v) {
	 	                 /* console.log(i+","+v[0]); */             
		            	
	 	                //23.10.20
	 	                //on load=  검색한 이력이 있다면, 인기검색어 안나오게한다.
		                //v[0] = '<svg onload=';	//테스트
		                if (v[0].includes('onload=')) {		                	
		                	v[0]  = '  ';
		                	//alert('zzz' + v[0] );
		                }else{
		                	v[0] = v[0].toUpperCase();
		                }        
		                
		             	// 검색어 리스트 a herf -> button onClick 으로 변경  250718 LSJ
	 	                var clickPpkHtml = "<li><button onClick=\"javascript:void(0);\" class=\"search-word-list-btn\" title=\"" + v[0] + "\" ><span>" + v[0] + "</span></button></li>";
		            	var dd = $("<dd>").append(clickPpkHtml);		            	
		            	
	 	                $('#ppk').append(dd);
		            	
		            });
	        	}
	        },	
	        error: function(jqXHR, textStatus, errorThrown) {
	          console.log(jqXHR, textStatus, errorThrown);
	        }
	    });
	    
	    console.log(" locale : " + locale);
	    drawSearchedKwd('ko_KR', $('#recentNoMsg').val());       // 최근검색어 리스트 출력.
	    akcInit('ko_KR'); // 자동완성 세팅	    
	}
	 
	   
	});
</script>
			
