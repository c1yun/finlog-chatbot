			var cType = $('body').data('client-type');
// 			if(Dr_MobileChk() == 'nomobile') {
			if (cType === 'app') {

				if ($.cookie("app_login_id")) {
					/* alert("app_login_id : " + $.cookie("app_login_id")); */
					window.Native.loginSuccess($.cookie("app_login_id"));	// 로그인 성공
					$.removeCookie("app_login_id",{path:'/'});
				}


				if ($.cookie("app_logout_id")) {
					/* alert("app_logout_id : " + $.cookie("app_logout_id")); */
					window.Native.logoutSuccess($.cookie("app_logout_id"));	// 로그아웃 성공
					$.removeCookie("app_logout_id",{path:'/'});
				}
			}

		});
	</script>
	
			
				
				
