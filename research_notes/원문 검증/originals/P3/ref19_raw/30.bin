<script>
$(document).ready(function(){
	/* var isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);
	alert(isMobile); */
	var isMobile = /Mobi/i.test(window.navigator.userAgent);
	
	if(isMobile) {
		$('.mn').css('width','100%');
		$('#division').remove();
	}
	
	$('.mn').on('click', function(){
		$(this).next('.nurizip-list').slideToggle(400);
		$('.mn').not(this).next('.nurizip-list').slideUp(400);
	});
});

function pageGoGov(){
	window.location.href = 'https://www.gov.kr/portal/orgInfo?Mcode=11180';
}

</script>

